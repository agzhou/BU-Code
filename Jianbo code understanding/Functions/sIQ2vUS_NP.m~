%% US g1 fit, fit negative and postive frequency signal separately
% For algorithm development, data analysis
% input: IQ(SVD filtered) 
% g1Info (g1 calculation parameters, including g1Info.tStart, g1Info.nt, g1Info.nTau)
% A_FWHM (X, Y, Z spatial resolution, um)
% rFrame (IQ frame rate, Hz)
% NP: negative and positive
% MskType, 1: use vULM data as mask
function [Ms, Mf, Vx, Vy, Vz, Vz0, Pvz,Vcz,R,GG]=sIQ2vUS_NP(sIQ, FitMsk0, g1Info, A_FWHM, rFrame, rfnScale, nItpT,MskType)
switch nargin
    case 5
        rfnScale=1;
        nItpT=1;
        MskType=0;
    case 6
        nItpT=1;
        MskType=0;
    case 7
        MskType=0;
end
%% I. spatial refine sIQ
[nz0,nx0,nt]=size(sIQ);
cIQ=zeros(nz0*rfnScale,nx0*rfnScale,nt);
if rfnScale>1
    for it=1:nt
        cIQ(:,:,it)=imresize(sIQ(:,:,it),[nz0,nx0]*rfnScale,'bilinear'); % spatial interpolation
    end
    if MskType==0
        FitMsk=imresize(FitMsk0,[nz0,nx0]*rfnScale, 'bilinear');
    else
        FitMsk=FitMsk0;
    end
else
    cIQ=sIQ;
    FitMsk=FitMsk0;
end
clear sIQ
%% II. constant
[nz,nx,nt]=size(cIQ);
Ms=zeros(nz,nx,2); % 1-positive frequency, 2-negative frequency
Vx=Ms; Vy=Ms; Vz=Ms;  Pvz=Vz; Vcz=zeros(nz,nx,3);
Mf=zeros(nz,nx,2,2);Vz0=Mf;
R=zeros(nz,nx,3);
GG=zeros(nz,nx,g1Info.nTau*nItpT,3,2); % dimension 4-[pg1,ng1,g1], dimension 5-[gg,ggfit]
rFrameItp=rFrame*nItpT;
f0=16.625e6; % ultrasound transducer center frequency, Hz
%% III. determine spectrum power ratio and signal (|f|<1000Hz) to noise ratio
fCoor=linspace(-rFrame/2,rFrame/2,nt)';
fCoorSig=zeros(size(fCoor));
fCoorSig(abs(fCoor)<1000)=1; % signal frequency range
fCoorSig=circshift(fCoorSig,nt/2);
% fIQ=(fft(cIQ,nt,3)); % no fft shift
fIQ=sysNoiseRemove(cIQ,rFrame);
fSNR(:,:,3)=squeeze(sum(abs(fIQ.*repmat(permute(fCoorSig,[3 2 1]),[nz nx 1])),3))./squeeze(sum(abs(fIQ),3)); % SNR of oringla data
% III.1 positive frequency signal and SNR, upwards flow , blueish
pfIQ=zeros(size(fIQ));
pfIQ(:,:,1:floor(nt/2))=fIQ(:,:,1:floor(nt/2)); % positive frequency signal
pIQ=(ifft(pfIQ,nt,3));
pfIQ_S=pfIQ.*repmat(permute(fCoorSig,[3 2 1]),[nz nx 1]);
fSNR(:,:,1)=squeeze(sum(abs(pfIQ_S),3))./squeeze(sum(abs(pfIQ),3)); % SNR of positive frequency signal
clear pfIQ_S pfIQ
% III.2 negative frequency signal and SNR, downwards flow, redish
nfIQ=zeros(size(fIQ));
nfIQ(:,:,floor(nt/2)+1:end)=fIQ(:,:,floor(nt/2)+1:end); % negative frequency signal
nIQ=(ifft(nfIQ,nt,3));
nfIQ_S=nfIQ.*repmat(permute(fCoorSig,[3 2 1]),[nz nx 1]);
fSNR(:,:,2)=squeeze(sum(abs(nfIQ_S),3))./squeeze(sum(abs(nfIQ),3));% SNR of negative frequency signal
clear nfIQ_S nfIQ
% III.3 positive, and negative ratio
Ppos=sum(abs(fIQ(:,:,1:floor(end/2)))-repmat(median(abs(fIQ(:,:,:)),3),[1 1 floor(nt/2)]),3); % spectrum power of positive frequency
Pneg=sum(abs(fIQ(:,:,floor(end/2)+1:end))-repmat(median(abs(fIQ(:,:,:)),3),[1 1 floor(nt/2)]),3); % spectrum power of negative frequency
pnRatio(:,:,1)=Ppos./(Pneg+Ppos); % positive power ratio
pnRatio(:,:,2)=Pneg./(Pneg+Ppos); % negative power ratio
clear Ppos Pneg fIQ
%% g1 fitting 
mskSNR=FitMsk;
zPix=max(floor(nz*0.1),1):1:floor(nz*1);
for iSNR=1:3
    if nz==1
        mskSNRthd(:,iSNR)=10;
        fSNRthd(:,iSNR)=0.3;
    else
        if MskType==1  %  for ULM fitting mask
            mskSNRthd=0.8*ones(nz,3);
            
            fSNR0=squeeze(fSNR(:,:,iSNR));
            zfSNR=(mean(fSNR0,2)-0.9*std(fSNR0,[],2));
            fC=polyfit(zPix,zfSNR(max(floor(nz*0.1),1):floor(nz*1))',1);
            z=1:nz;
            fSNRthd(:,iSNR)=polyval(fC,z);
        else
            mskSNR0=squeeze(mskSNR(:,:,iSNR));
            zmskSNR=(mean(mskSNR0,2)-0.8*std(mskSNR0,[],2));
            mskC=polyfit(zPix,zmskSNR(max(floor(nz*0.1),1):floor(nz*1))',1);
            z=1:nz;
            mskSNRthd(:,iSNR)=polyval(mskC,z);
            
            fSNR0=squeeze(fSNR(:,:,iSNR));
            zfSNR=(mean(fSNR0,2)-0.8*std(fSNR0,[],2));
            fC=polyfit(zPix,zfSNR(max(floor(nz*0.1),1):floor(nz*1))',1);
            z=1:nz;
            fSNRthd(:,iSNR)=polyval(fC,z);
        end
        
    end
end
if MskType==1
    pnRatioThd=0.25; % pn Raion threshold when using vULM mask
else
    pnRatioThd=0.3;% pn Raion threshold when using PDI mask
end
%% IV. Fitting criteria
warning off;
for iz=1:nz
    for ix=1:nx
        %% IV.1 fitting criteria
        if FitMsk(iz,ix,3)>mskSNRthd(iz,3) && fSNR(iz,ix,3)>fSNRthd(iz,3)
            %% IV.3 all frequency
            GG(iz,ix,:,3,1)=interp(squeeze(IQ2g1(cIQ(iz,ix,:),g1Info.tStart,g1Info.nt,g1Info.nTau)),nItpT);
            [Vcz(iz,ix,3)]=ColorDoppler(cIQ(iz,ix,:),f0,rFrame); % color Doppler, all frequency
            if squeeze(abs(GG(iz,ix,1,3,1)))>0.15
                %% IV.2 fit positive frequency signal
                if (pnRatio(iz,ix,1)>=0.2 || fSNR(iz,ix,1)>0.55) && FitMsk(iz,ix,1)>mskSNRthd(iz,1)*0.95 && fSNR(iz,ix,1)>fSNRthd(iz,1) %
                    [Vcz(iz,ix,1)]=ColorDoppler(pIQ(iz,ix,:),f0,rFrame); % color Doppler, positive frequency only
                    GG(iz,ix,:,1,1)=interp(squeeze(IQ2g1(pIQ(iz,ix,:),g1Info.tStart,g1Info.nt,g1Info.nTau)),nItpT);
                    [Ms(iz,ix,1), Mf(iz,ix,1,:), Vx(iz,ix,1), Vy(iz,ix,1), Vz(iz,ix,1),Vz0(iz,ix,:,1),Pvz(iz,ix,1),R(iz,ix,1),GG(iz,ix,:,1,2)]=USg1fit_DV(GG(iz,ix,:,1,1), A_FWHM, rFrameItp);
                else
                    GG(iz,ix,:,1,1)=interp(squeeze(IQ2g1(pIQ(iz,ix,:),g1Info.tStart,g1Info.nt,g1Info.nTau)),nItpT);
                    GG(iz,ix,:,1,2)=GG(iz,ix,:,1,1);
                end
                %% IV.2 fit negative frequency signal
                if (pnRatio(iz,ix,2)>=pnRatioThd) && FitMsk(iz,ix,2)>mskSNRthd(iz,2) && fSNR(iz,ix,2)>fSNRthd(iz,2) %
                    [Vcz(iz,ix,2)]=ColorDoppler(nIQ(iz,ix,:),f0,rFrame); % color Doppler, negative frequency only
                    GG(iz,ix,:,2,1)=interp(squeeze(IQ2g1(nIQ(iz,ix,:),g1Info.tStart,g1Info.nt,g1Info.nTau)),nItpT);
                    [Ms(iz,ix,2), Mf(iz,ix,2,:), Vx(iz,ix,2), Vy(iz,ix,2), Vz(iz,ix,2),Vz0(iz,ix,:,2),Pvz(iz,ix,2),R(iz,ix,2),GG(iz,ix,:,2,2)]=USg1fit_DV(GG(iz,ix,:,2,1), A_FWHM, rFrameItp);
                else
                    GG(iz,ix,:,2,1)=interp(squeeze(IQ2g1(nIQ(iz,ix,:),g1Info.tStart,g1Info.nt,g1Info.nTau)),nItpT);
                    GG(iz,ix,:,2,2)=GG(iz,ix,:,2,1);
                end
                GG(iz,ix,:,3,2)=GG(iz,ix,:,1,2)*pnRatio(iz,ix,1)+GG(iz,ix,:,2,2)*pnRatio(iz,ix,2);
                GG(iz,ix,:,3,2)=GG(iz,ix,:,3,2)/GG(iz,ix,1,3,2)*GG(iz,ix,1,3,1);
                R(iz,ix,3)=1 - sum( abs(squeeze(GG(iz,ix,:,3,2))-squeeze(GG(iz,ix,:,3,1))).^2 ) / sum( abs(squeeze(GG(iz,ix,:,3,1))-mean(squeeze(GG(iz,ix,:,3,1)))).^2);
            end
        end
    end
end
%% Vz 
Vz(:,:,1)=-1*abs(Vz(:,:,1));
Vz(:,:,2)=1*abs(Vz(:,:,2));
Vcz=-1*Vcz;
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
            


